# ============================================================
# Stranalyser – Umgebungsvariablen
# ============================================================
# 1. Strava-App erstellen: https://www.strava.com/settings/api
# 2. Diese Datei als .env kopieren und ausfüllen
# 3. docker compose up --build
# ============================================================

# --- Strava OAuth ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# API-Port: http://localhost:8000/api/auth/callback
# LAN:      http://192.168.x.x:8000/api/auth/callback
STRAVA_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Frontend URL (für OAuth-Redirect nach Login) ---
FRONTEND_URL=http://localhost:5173

# --- Datenbank ---
DB_PASSWORD=change_me_in_production

# --- App ---
# Zufälligen String generieren: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_string

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- KI-Analyse ---
# Aktiver Provider: "anthropic" oder "google"
AI_PROVIDER=anthropic

# Modell des aktiven Providers.
# Anthropic-Modelle: claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
# Google-Modelle:    gemini-2.0-flash | gemini-2.0-flash-thinking-exp | gemini-1.5-pro | gemini-1.5-flash
AI_MODEL=claude-sonnet-4-6

# API-Keys – nur der Key des aktiven Providers muss gesetzt sein.
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
