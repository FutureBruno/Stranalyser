# ============================================================
# Stranalyser – Umgebungsvariablen
# ============================================================
# 1. Strava-App erstellen: https://www.strava.com/settings/api
# 2. Diese Datei als .env kopieren und ausfüllen
# 3. docker compose up --build
# ============================================================

# --- Strava OAuth ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Redirect URI muss exakt mit der Strava-App übereinstimmen
# Für lokales Netzwerk: http://192.168.x.x:8080/api/auth/callback
# Für einzelne Maschine: http://localhost:8080/api/auth/callback
STRAVA_REDIRECT_URI=http://localhost:8080/api/auth/callback

# --- Datenbank ---
DB_PASSWORD=change_me_in_production
# Wird von Docker Compose automatisch zusammengebaut:
# DATABASE_URL wird intern gesetzt

# --- App ---
APP_PORT=8080
# Zufälligen String generieren: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_string

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
